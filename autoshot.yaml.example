# autoshot 项目配置示例：复制到目标工程根目录并改名为 autoshot.yaml
# 所有字段均可省略，CLI 参数优先级更高

# device_serial: "127.0.0.1:5555"
# hdc_path: hdc
# screen_size: [1080, 2340]
# image_format: png            # png | jpeg（设备截屏恒为 JPEG，png 需装 Pillow 转码）
# locale: zh_CN                # 限定语种；缺省用所有语种值参与匹配
# output_dir: shots
# max_scroll_steps: 12
# viewport_margin_top: 96
# viewport_margin_bottom: 96
# viewport_margin_side: 16
# idle_timeout: 6.0
# poll_interval: 0.4
# scroll_direction: up
# grant_texts: ["允许", "仅使用期间允许"]
# dismiss_texts: ["我知道了", "暂不升级"]

# ---- LLM 视觉决策（P1，可选）----
# 未配置 llm 或 api_key 为空时，运行时探索只用启发式，不调用模型。
# 配置后，启发式穷尽时会把剪枝控件树 + 截图交给视觉模型判下一步。
# llm:
#   base_url: https://api.openai.com/v1   # OpenAI 兼容接口，DeepSeek/Qwen/GPT-4o 均可
#   api_key: "sk-xxxxxxxxxxxxxxxx"        # 或环境变量 AUTOSHOT_LLM_API_KEY
#   model: gpt-4o                         # 需 vision，或 AUTOSHOT_LLM_MODEL
#   max_calls_per_key: 8                  # 每个资源 key 的模型调用上限（token 预算）
#   timeout: 30
#   max_tokens: 300

# ---- 白盒注入直达（P2，可选）----
# 需被测工程入口按 docs/inject_example.md 加一次注入分支，然后 enabled: true 启用。
# inject:
#   enabled: false
#   bundle: com.example.app               # 可选，缺省读 AppScope/app.json5 的 bundleName
